# ===========================================
# AI Relay Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_to_a_strong_password
MYSQL_DATABASE=ai_relay

# ---------- Spring Datasource ----------
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me_to_a_strong_password

# ---------- JWT ----------
JWT_SECRET=change_me_to_a_long_random_secret_key_at_least_256_bits

# ---------- Alipay ----------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ---------- WeChat Pay ----------
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_CERT_PATH=
